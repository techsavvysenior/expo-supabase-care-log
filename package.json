{
  "name": "expo-supabase-care-log",
  "version": "1.0.0",
  "description": "React Native (Expo) and Supabase care log for multi-site residential care: tenant isolation in Postgres, append-only care notes, a medication record, audit trail, PHI-free notifications (Expo push, Resend, Twilio), AI handoff drafts (OpenAI), Google geocoding, Sentry and PostHog.",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:db": "node --test \"supabase/tests/*.test.mts\"",
    "test:functions": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/tests/",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "check:traceability": "node scripts/traceability.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db && npm run check:traceability"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "posthog-react-native": "^4.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  }
}
