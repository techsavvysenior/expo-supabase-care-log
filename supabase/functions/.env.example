# Edge Function secrets: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.

CRON_SECRET=<long random string, same value as the cron_secret Vault secret>

# Expo push. Only needed if "enhanced push security" is on for the project.
EXPO_ACCESS_TOKEN=

# Resend
RESEND_API_KEY=re_...
RESEND_FROM=Care Log <alerts@yourdomain.example>

# Twilio (optional; without it, missed-dose alerts go by push and email only)
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=MG...

# OpenAI. Only send PHI after the Business Associate Addendum is signed.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=<model id from your OpenAI account>

# Google Geocoding API
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_REGION=us

APP_SCHEME=carelog
